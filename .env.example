# Monitor address, leave it blank to monitor all network cards
# HOST=127.0.0.1
# port number
# PORT=3000
#Front-end basic URL
# FRONTEND_BASE_URL=https://your-frontend-url.com


#Debug related configurations
# enable pprof
# ENABLE_PPROF=true
# Enable debug mode
# DEBUG=true
#Default language: log output, as well as prompts, emails and notifications returned when the other party does not specify a language. Optional en, zh-CN, zh-TW, not set to en
# DEFAULT_LANGUAGE=zh-CN
# Pyroscope configuration
# PYROSCOPE_URL=http://localhost:4040
# PYROSCOPE_APP_NAME=new-api
# PYROSCOPE_BASIC_AUTH_USER=your-user
# PYROSCOPE_BASIC_AUTH_PASSWORD=your-password
# PYROSCOPE_MUTEX_RATE=5
# PYROSCOPE_BLOCK_RATE=5
# HOSTNAME=your-hostname

# Database related configuration
# Enable error logging
# ERROR_LOG_ENABLED=true
# Database connection string
# SQL_DSN=user:password@tcp(127.0.0.1:3306)/dbname?parseTime=true
# Log database connection string
# LOG_SQL_DSN=user:password@tcp(127.0.0.1:3306)/logdb?parseTime=true
# SQLite database path
# SQLITE_PATH=/path/to/sqlite.db
#Maximum number of idle connections in the database
# SQL_MAX_IDLE_CONNS=100
#Maximum number of open connections to the database
# SQL_MAX_OPEN_CONNS=1000
#Maximum database connection life cycle (seconds)
# SQL_MAX_LIFETIME=60
# Slow query log threshold (milliseconds), 0 means turning off slow query log, falling back to the default value of 200 when exceeding the range of 0-3600000
# SQL_SLOW_THRESHOLD_MS=200
# Skip 64-bit schema check for user quota column (only enabled if database column is confirmed to accommodate 64-bit)
# SKIP_64BIT_QUOTA_SCHEMA_CHECK=true


# Cache related configuration
# Redis connection string
# REDIS_CONN_STRING=redis://user:password@localhost:6379/0
# Synchronization frequency (unit: seconds)
# SYNC_FREQUENCY=60
# Memory cache enabled
# MEMORY_CACHE_ENABLED=true
# Channel update frequency (unit: seconds)
# CHANNEL_UPDATE_FREQUENCY=30
# Enable batch updates
# BATCH_UPDATE_ENABLED=true
# Batch update interval (unit: seconds)
# BATCH_UPDATE_INTERVAL=5

# Task and function configuration
# Update task enabled
# UPDATE_TASK=true
# Asynchronous task hard timeout (minutes), calculated based on submission time, unfinished tasks after timeout will be marked as failed and refunded; 0 means disabled
# TASK_TIMEOUT_MINUTES=4320
# Asynchronous task continuous polling failure threshold (upstream 429/5xx/401/403, network error, unrecognized response), when reached, the task will be marked as failed and refunded; normal polling will be reset to zero if it succeeds once
# TASK_POLL_MAX_FAILURES=20
# The maximum memory that the plugin can allocate for each JavaScript call, in MB, defaults to 512, 0 means no limit; when increasing MAX_REQUEST_BODY_MB, you usually need to increase it as well.
# PLUGIN_MEMORY_LIMIT_MB=512

# Conversation timeout setting
# All request timeouts, in seconds, default is 0, indicating no limit
# RELAY_TIMEOUT=0
# Relay HTTP client idle connection timeout, unit seconds, defaults to follow the Go standard library, set to 0 means no limit
# RELAY_IDLE_CONN_TIMEOUT=90
# The number of seconds after which the HTTP/2 connection does not receive any frames before sending a PING; 0 (default) turns off health detection.
# Applies to upstream connections, including proxy and shard connections; independent of SSE heartbeats sent to clients.
# RELAY_HTTP2_PING_IDLE_TIMEOUT=0
# Number of seconds to wait for a PING reply after enabling probing; 0 or negative uses the Go default of 15 seconds.
# Only close unanswered connections, and slow requests with normal responses can continue to wait.
# RELAY_HTTP2_PING_TIMEOUT=15
# The timeout for waiting for the upstream to return a response header, in seconds, defaults to 1800, set to 0 to indicate no limit.
# Only the "waiting for response header" section is constrained; streaming after the response header is returned is not affected.
# Note: Non-streaming requests usually do not return response headers until upstream generation is completed, so this value needs to be left with sufficient margin.
# RELAY_RESPONSE_HEADER_TIMEOUT=1800
# No response timeout in streaming mode, in seconds. If empty completion occurs, try changing it to a larger value.
# STREAMING_TIMEOUT=300

# TLS/HTTP skip verification settings
# TLS_INSECURE_SKIP_VERIFY=false

# Gin trusted reverse proxy (comma separated IP/CIDR)
# Not configured/leaved blank: Trust 127.0.0.0/8, ::1, RFC1918 private network and fc00::/7 by default, and print startup alarms.
# none: Strict mode, no proxy is trusted and must be used alone; the explicit list completely replaces the default value, and the proxy's own address should be filled in.
# TRUSTED_PROXIES=none
# TRUSTED_PROXIES=127.0.0.1,172.20.0.0/16

# Gemini recognizes pictures Maximum number of pictures
# GEMINI_VISION_MAX_IMAGE_NUM=16

# session key
# SESSION_SECRET=random_string
# RSA-OAEP encryption for login password request body; turned off by default and cannot replace HTTPS
# PASSWORD_LOGIN_ENCRYPTION_ENABLED=true

# Account password storage. For a rolling upgrade, deploy every node with bcrypt
# first (dual-format verification), then switch all nodes to argon2id before
# enabling long passwords. A rollback must retain Argon2id verification and
# v2 login-password envelope support (when login encryption is enabled).
# Existing bcrypt hashes and MFA backup codes are not rewritten.
# ACCOUNT_PASSWORD_HASH_ALGORITHM=argon2id
# false/not configured: local HTTP mode, refresh/logout OriginGuard is turned off, and TRUSTED_URL must not be set; compatible with local development agents.
# true: Enable Secure Refresh Cookie and strict OriginGuard, all trusted HTTPS Origins must be listed at the same time.
# SESSION_COOKIE_TRUSTED_URL Multiple items are separated by English commas; wildcard, path or domain name suffix matching is not supported.
# These settings do not modify relay CORS.
# SESSION_COOKIE_SECURE=false
# SESSION_COOKIE_TRUSTED_URL=https://example.com,https://admin.example.com
# Maximum number of active login sessions retained per user
# USER_SESSION_ACTIVE_LIMIT=50
# The total number of sessions a single user is allowed to create within the issuance window (including revoked ones)
# USER_SESSION_ISSUANCE_LIMIT=100
# Session issuance count window (seconds); it must not be greater than the revoked retention period, and will be automatically clamped when exceeded.
# USER_SESSION_ISSUANCE_WINDOW_SECONDS=86400
# revoked Session audit retention days
# USER_SESSION_REVOKED_RETENTION_DAYS=7
# When the global session issuance volume in the last hour exceeds this value, an alarm will be logged and login will not be refused.
# USER_SESSION_HOURLY_ALERT_THRESHOLD=5000

# Other configurations
# Generate default token
# GENERATE_DEFAULT_TOKEN=false
# Cohere security settings
# COHERE_SAFETY_SETTING=NONE
# Whether to count image tokens
# GET_MEDIA_TOKEN=true
# Whether to count image tokens in non-streaming (stream=false) conditions
# GET_MEDIA_TOKEN_NOT_STREAM=false
#Set whether the Dify channel outputs workflow and node information to the client
# DIFY_DEBUG=true

#LinuxDo related configuration
LINUX_DO_TOKEN_ENDPOINT=https://connect.linux.do/oauth2/token
LINUX_DO_USER_ENDPOINT=https://connect.linux.do/api/user

# Node type
# If it is the master node, it is master
# NODE_TYPE=master

# List of trusted redirect domain names (comma separated, supports subdomain matching)
# Domain name security used to verify payment success/cancellation callback URL
# Example: example.com,myapp.io will allow example.com, sub.example.com, myapp.io, etc.
# TRUSTED_REDIRECT_DOMAINS=example.com,myapp.io
