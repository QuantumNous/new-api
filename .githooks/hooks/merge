#!/usr/bin/env python3
"""merge hook: validates PR, reviews, cleanup before squash-merge.

Usage:
    python .githooks/hooks/merge <owner/repo> <pr_number> [--dry-run]

--dry-run: plan only, no squash.
"""
import sys
from pathlib import Path
ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT))
sys.path.insert(0, str(ROOT / ".."))
from lib._shared import Finding, Severity, aggregate_result, print_findings, load_yaml, gh_api_get, gh_api_paginate  # noqa: E402
def main() -> int:
    args = [a for a in sys.argv[1:] if not a.startswith("--")]
    dry_run = "--dry-run" in sys.argv

    if len(args) < 2:
        print("Usage: python .githooks/hooks/merge <owner/repo> <pr_number> [--dry-run]")
        return 2

    repo, pr_num = args[0], int(args[1])
    cfg = load_yaml(ROOT / "spec" / "dispatch.yaml")
    findings: list[Finding] = []

    print(f"== Merge #{pr_num} ({repo}) ==")
    if dry_run:
        print("[DRY-RUN]")

    for topic in cfg.get("merge", []):
        print(f"--- {topic} ---")
        if topic == "github/pull_requests":
            from github.pull_requests import run as pr_run
            findings.extend(pr_run(repo, pr_num))
        elif topic == "github/reviews":
            review_cfg = load_yaml(ROOT / "spec" / "github_reviews.yaml")
            review_comments = gh_api_paginate(f"repos/{repo}/pulls/{pr_num}/comments")
            issue_comments = gh_api_get(f"repos/{repo}/issues/{pr_num}/comments") or []
            all_comments = list(review_comments or []) + list(issue_comments or [])
            from github.reviews import run as review_run
            findings.extend(review_run(all_comments, review_cfg))
        elif topic == "cleanup":
            from cleanup.branch_cleanup import run as branch_run
            findings.extend(branch_run(apply=False))

    # 本地审查：CRG 结构分析 + ocr AI 审查
    print("--- review (CRG + ocr) ---")
    try:
        from dev.ocr_review import _run_crg, _run_ocr, _format_ocr_results
        crg_out = _run_crg()
        print(crg_out[:1200] if crg_out else "（无 CRG 输出）")
        print()
        print("（ocr 运行中，LLM 需几分钟...）")
        sys.stdout.flush()
        ocr_raw = _run_ocr()
        ocr_text = _format_ocr_results(ocr_raw)
        print(ocr_text[:1500])
    except Exception as e:
        print(f"review 跳过: {e}")

    if rc == 0 and not dry_run:
        print("All checks passed. Ready for squash-merge.")
        # Extract Fixes from PR body
        try:
            pr = gh_api_get(f"repos/{repo}/pulls/{pr_num}")
            if pr:
                body = pr.get("body", "") or ""
                import re
                fixes = re.findall(r"(?:Fixes|Closes|Resolves)\s+#(\d+)", body)
                if fixes:
                    print(f"Fixes: #{', #'.join(fixes)}")
                print(f"Branch: {pr.get('head', {}).get('ref', '')}")
        except Exception as e:
            print(f"WARN: could not extract merge info: {e}")

    return rc


if __name__ == "__main__":
    sys.exit(main())