#!/usr/bin/env python3
"""pre-push hook: runs workspace + code + github checks."""
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT))
sys.path.insert(0, str(ROOT / ".."))

from lib._shared import Finding, Severity, aggregate_result, print_findings, load_yaml  # noqa: E402


def main() -> int:
    cfg = load_yaml(ROOT / "spec" / "dispatch.yaml")
    findings: list[Finding] = []

    for topic in cfg.get("pre-push", []):
        print(f"--- {topic} ---")
        if topic == "workspace":
            from workspace.tree_hygiene import run as tree_run
            from workspace.file_placement import run as placement_run
            findings.extend(tree_run())
            findings.extend(placement_run())
        elif topic == "code":
            from code.lint import run as code_run
            findings.extend(code_run())

    print_findings(findings)
    return aggregate_result(findings)


if __name__ == "__main__":
    sys.exit(main())
