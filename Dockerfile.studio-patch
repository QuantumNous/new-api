# Patch-only build: compile the rc.21 source tree with Chimera backend patches.
# Frontend dist is built in-image because official images do not ship /web as loose files.
FROM oven/bun:1@sha256:0733e50325078969732ebe3b15ce4c4be5082f18c4ac1a0f0ca4839c2e4e42a7 AS web-default

WORKDIR /build/web
COPY web/package.json web/bun.lock ./
RUN set -eux; \
    for attempt in 1 2 3; do \
      bun install --frozen-lockfile && exit 0; \
      rm -rf /root/.bun/install/cache; \
      sleep $((attempt * 2)); \
    done; \
    exit 1
COPY ./web ./
COPY ./VERSION /build/VERSION
RUN DISABLE_ESLINT_PLUGIN='true' VITE_REACT_APP_VERSION=$(tr -d '\r\n' </build/VERSION) bun run build

FROM golang:1.26.1-alpine@sha256:2389ebfa5b7f43eeafbd6be0c3700cc46690ef842ad962f6c5bd6be49ed82039 AS builder
ENV GO111MODULE=on CGO_ENABLED=0 GOEXPERIMENT=greenteagc GOMAXPROCS=1

ARG TARGETOS
ARG TARGETARCH
ENV GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH:-amd64}

WORKDIR /build
ADD go.mod go.sum ./
RUN go mod download
COPY . .
COPY --from=web-default /build/web/dist ./web/dist
RUN go build -ldflags "-s -w -X 'github.com/QuantumNous/new-api/common.Version=$(tr -d '\r\n' <VERSION)'" -o new-api

FROM debian:bookworm-slim@sha256:f06537653ac770703bc45b4b113475bd402f451e85223f0f2837acbf89ab020a

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates tzdata libasan8 wget \
    && rm -rf /var/lib/apt/lists/* \
    && update-ca-certificates

COPY --from=builder /build/new-api /
COPY LICENSE NOTICE THIRD-PARTY-LICENSES.md /licenses/
EXPOSE 3000
WORKDIR /data
ENTRYPOINT ["/new-api"]
