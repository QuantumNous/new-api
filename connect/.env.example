# Local release builds only. CI builds read these from repository secrets
# (see .github/workflows/connect-release.yml); this file is for the emergency
# `make connect-build` path on a developer machine.

# Apple Developer ID notarization (macOS)
APPLE_ID=you@example.com
APPLE_TEAM_ID=XXXXXXXXXX
APPLE_APP_SPECIFIC_PASSWORD=xxxx-xxxx-xxxx-xxxx
# Optional override; otherwise Tauri picks the first Developer ID Application identity.
# APPLE_SIGNING_IDENTITY=Developer ID Application: Example (TEAMID)

# Tauri updater minisign (required when createUpdaterArtifacts is true)
# Either the key body (single line is fine) or an absolute path to the key file.
TAURI_SIGNING_PRIVATE_KEY=
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=

# Debug/test builds only: point Connect at a local gateway instead of
# https://you-box.com. Release builds ignore this and stay pinned.
# BOXAI_CONNECT_HOST=http://127.0.0.1:3000
