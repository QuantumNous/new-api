# Copy to app.env and fill in. Both slots read this file, so everything here
# must be identical across them.
#
# PostgreSQL or MySQL is required: the two slots share one database, and SQLite
# cannot be written by two processes.
SQL_DSN=postgresql://root:CHANGE_ME@postgres:5432/new-api
# SQL_DSN=root:CHANGE_ME@tcp(mysql:3306)/new-api

REDIS_CONN_STRING=redis://:CHANGE_ME@redis:6379

# Must be identical in every slot; otherwise sessions and CSRF checks fail
# after a switch.
SESSION_SECRET=CHANGE_ME_TO_A_RANDOM_STRING
# SESSION_COOKIE_SECURE=true
# SESSION_COOKIE_TRUSTED_URL=https://example.com

# Both slots must see the same option values, and the relay chain is the
# gateway, so proxy headers are what identify the client.
SYNC_FREQUENCY=60
ERROR_LOG_ENABLED=true
BATCH_UPDATE_ENABLED=true
STREAMING_TIMEOUT=300
# SHUTDOWN_TIMEOUT_SECONDS=120
