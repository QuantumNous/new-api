# Copy to .env and fill in real values. NEVER commit .env.

# Docker image built from the fork
IMAGE=registry.mrdnd.dev/new-api:latest

# PostgreSQL
POSTGRES_USER=newapi
POSTGRES_PASSWORD=CHANGE_ME_long_random_string
POSTGRES_DB=new-api

# Redis
REDIS_PASSWORD=CHANGE_ME_long_random_string

# App secrets — generate with: openssl rand -hex 32
SESSION_SECRET=CHANGE_ME_openssl_rand_hex_32
CRYPTO_SECRET=CHANGE_ME_openssl_rand_hex_32

# Traefik — adjust to match your existing Traefik setup on the VPS.
# TRAEFIK_NETWORK must be an existing external docker network Traefik watches.
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt
