# /opt/new-api/deploy/.env.podman
# Copy to /opt/new-api/deploy/.env and fill real values before starting units.

SQL_DSN=postgresql://root:change-me@127.0.0.1:5432/new-api
SESSION_SECRET=change-me
CRYPTO_SECRET=change-me
TRUSTED_PROXIES=127.0.0.1
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_TRUSTED_URL=https://example.com
TZ=Asia/Shanghai
PORT=3000
NODE_NAME=new-api-node-1
ERROR_LOG_ENABLED=true
BATCH_UPDATE_ENABLED=true
TIMESCALEDB_ENABLED=true
TIMESCALEDB_CHUNK_INTERVAL_SECONDS=86400
TIMESCALEDB_COMPRESS_AFTER_DAYS=3
ENABLE_PPROF=false
GOMEMLIMIT=512MiB
GODEBUG=gctrace=1
RELAY_TIMEOUT=300
STREAMING_TIMEOUT=300
