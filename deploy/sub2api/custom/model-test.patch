+
+const apiKeys = ref<ApiKey[]>([])
+const selectedKeyId = ref<number | ''>('')
+const loadingKeys = ref(false)
+const mode = ref<TestMode>('image')
+const textModel = ref('gemini-2.5-flash')
+const imageModel = ref('gemini-3.1-flash-image')
+const aspectRatio = ref('1:1')
+const imageSize = ref('1K')
+const prompt = ref('生成一只戴宇航员头盔的橘猫，干净的浅色背景，细节清晰。')
+const sourceImage = ref<SourceImage | null>(null)
+const sourceImageError = ref('')
+const sourceImageInputKey = ref(0)
+const status = ref<TestStatus>('idle')
+const httpStatus = ref(0)
+const latencyMs = ref(0)
+const textOutput = ref('')
+const generatedImages = ref<PreviewImage[]>([])
+const responseSummary = ref('')
+const errorMessage = ref('')
+const previewImageUrl = ref('')
+let abortController: AbortController | null = null
+
+const selectedKey = computed(() => apiKeys.value.find((key) => key.id === selectedKeyId.value))
+const isImageMode = computed(() => mode.value !== 'text')
+const activeModel = computed(() => isImageMode.value ? imageModel.value : textModel.value)
+const canSubmit = computed(() => Boolean(
+  selectedKey.value?.key
+  && activeModel.value.trim()
+  && prompt.value.trim()
+  && (mode.value !== 'edit' || sourceImage.value)
+))
+
+function maskApiKey(value: string): string {
+  if (value.length <= 12) return `${value.slice(0, 4)}...`
+  return `${value.slice(0, 6)}...${value.slice(-4)}`
+}
+
+function isRecord(value: unknown): value is Record<string, unknown> {
+  return typeof value === 'object' && value !== null && !Array.isArray(value)
+}
+
+function extractError(payload: unknown, fallback: string): string {
+  if (!isRecord(payload)) return fallback
+  if (typeof payload.message === 'string' && payload.message) return payload.message
+  if (typeof payload.detail === 'string' && payload.detail) return payload.detail
+  if (isRecord(payload.error)) {
+    if (typeof payload.error.message === 'string' && payload.error.message) return payload.error.message
+    if (typeof payload.error.status === 'string' && payload.error.status) return payload.error.status
+  }
+  return fallback
+}
+
+function extractText(payload: unknown): string {
+  if (!isRecord(payload)) return ''
+
+  if (Array.isArray(payload.content)) {
+    const text = payload.content
+      .filter(isRecord)
+      .map((part) => typeof part.text === 'string' ? part.text : '')
+      .filter(Boolean)
+      .join('\n')
+    if (text) return text
+  }
+
+  if (Array.isArray(payload.candidates)) {
+    const chunks: string[] = []
+    for (const candidate of payload.candidates) {
+      if (!isRecord(candidate) || !isRecord(candidate.content) || !Array.isArray(candidate.content.parts)) continue
+      for (const part of candidate.content.parts) {
+        if (isRecord(part) && typeof part.text === 'string' && part.text) chunks.push(part.text)
+      }
+    }
+    if (chunks.length > 0) return chunks.join('\n')
+  }
+
+  if (typeof payload.completion === 'string') return payload.completion
+  return ''
+}
+
+function extractImages(payload: unknown): PreviewImage[] {
+  if (!isRecord(payload) || !Array.isArray(payload.candidates)) return []
+  const images: PreviewImage[] = []
+
+  for (const candidate of payload.candidates) {
+    if (!isRecord(candidate) || !isRecord(candidate.content) || !Array.isArray(candidate.content.parts)) continue
+    for (const part of candidate.content.parts) {
+      if (!isRecord(part)) continue
+      const inlineData = isRecord(part.inlineData) ? part.inlineData : isRecord(part.inline_data) ? part.inline_data : null
+      if (!inlineData || typeof inlineData.data !== 'string' || !inlineData.data) continue
+      const mimeType = typeof inlineData.mimeType === 'string'
+        ? inlineData.mimeType
+        : typeof inlineData.mime_type === 'string'
+          ? inlineData.mime_type
+          : 'image/png'
+      images.push({ url: `data:${mimeType};base64,${inlineData.data}`, mimeType })
+    }
+  }
+
+  return images
+}
+
+function summarizeResponse(payload: unknown): string {
+  return JSON.stringify(payload, (key, value) => {
+    if (key === 'data' && typeof value === 'string' && value.length > 200) {
+      return `[base64 omitted: ${value.length} characters]`
+    }
+    return value
+  }, 2)
+}
+
+function extensionFor(mimeType: string): string {
+  if (mimeType.includes('jpeg')) return 'jpg'
+  if (mimeType.includes('webp')) return 'webp'
+  return 'png'
+}
+
+function resetResult(): void {
+  status.value = 'idle'
+  httpStatus.value = 0
+  latencyMs.value = 0
+  textOutput.value = ''
+  generatedImages.value = []
+  responseSummary.value = ''
+  errorMessage.value = ''
+  previewImageUrl.value = ''
+}
+
+function setMode(nextMode: TestMode): void {
+  if (mode.value === nextMode) return
+  cancelRequest()
+  mode.value = nextMode
+  if (nextMode === 'text') {
+    prompt.value = '请只回复：Sub2API account pool OK'
+    clearSourceImage()
+  } else if (nextMode === 'edit') {
+    prompt.value = '保持原图主体和构图不变，将背景改成干净的浅蓝色，并增强画面细节。'
+  } else {
+    prompt.value = '生成一只戴宇航员头盔的橘猫，干净的浅色背景，细节清晰。'
+    clearSourceImage()
+  }
+  resetResult()
+}
+
+function clearSourceImage(): void {
+  sourceImage.value = null
+  sourceImageError.value = ''
+  sourceImageInputKey.value += 1
+}
+
+async function handleSourceImageChange(event: Event): Promise<void> {
+  const input = event.currentTarget as HTMLInputElement
+  const file = input.files?.[0]
+  if (!file) {
+    clearSourceImage()
+    return
+  }
+
+  if (!SOURCE_IMAGE_MIME_TYPES.has(file.type) || file.size > MAX_SOURCE_IMAGE_BYTES) {
+    clearSourceImage()
+    sourceImageError.value = t('admin.accounts.modelTest.invalidSourceImage')
+    return
+  }
+
+  sourceImageError.value = ''
+  try {
+    const url = await new Promise<string>((resolve, reject) => {
+      const reader = new FileReader()
+      reader.onload = () => typeof reader.result === 'string' ? resolve(reader.result) : reject(new Error('Invalid file result'))
+      reader.onerror = () => reject(reader.error ?? new Error('Failed to read file'))
+      reader.readAsDataURL(file)
+    })
+    const separatorIndex = url.indexOf(',')
+    if (separatorIndex < 0) throw new Error('Invalid data URL')
+    sourceImage.value = {
+      url,
+      data: url.slice(separatorIndex + 1),
+      mimeType: file.type,
+      name: file.name,
+      size: file.size
+    }
+  } catch {
+    clearSourceImage()
+    sourceImageError.value = t('admin.accounts.modelTest.sourceImageReadFailed')
+  }
+}
+
+async function loadKeys(): Promise<void> {
+  loadingKeys.value = true
+  try {
+    const response = await keysAPI.list(1, 100, { status: 'active' })
+    apiKeys.value = response.items.filter((key) => key.status === 'active')
+    const antigravityKey = apiKeys.value.find((key) => key.group?.platform === 'antigravity')
+    selectedKeyId.value = antigravityKey?.id ?? apiKeys.value[0]?.id ?? ''
+  } catch (error) {
+    console.error('Failed to load API keys:', error)
+    errorMessage.value = t('admin.accounts.modelTest.loadKeysFailed')
+    status.value = 'error'
+  } finally {
+    loadingKeys.value = false
+  }
+}
+
+function cancelRequest(): void {
+  abortController?.abort()
+  abortController = null
+  if (status.value === 'loading') status.value = 'idle'
+}
+
+async function sendRequest(): Promise<void> {
+  if (!canSubmit.value || !selectedKey.value) return
+
+  cancelRequest()
+  resetResult()
+  status.value = 'loading'
+  abortController = new AbortController()
+  const startedAt = performance.now()
+
+  const url = isImageMode.value
+    ? `/antigravity/v1beta/models/${encodeURIComponent(imageModel.value)}:generateContent`
+    : '/v1/messages'
+  const imageParts: Record<string, unknown>[] = [{ text: prompt.value.trim() }]
+  if (mode.value === 'edit' && sourceImage.value) {
+    imageParts.unshift({
+      inlineData: {
+        mimeType: sourceImage.value.mimeType,
+        data: sourceImage.value.data
+      }
+    })
+  }
+  const body = isImageMode.value
+    ? {
+        contents: [{ role: 'user', parts: imageParts }],
+        generationConfig: {
+          maxOutputTokens: 4096,
+          imageConfig: { aspectRatio: aspectRatio.value, imageSize: imageSize.value }
+        }
+      }
+    : {
+        model: textModel.value.trim(),
+        max_tokens: 512,
+        stream: false,
+        messages: [{ role: 'user', content: prompt.value.trim() }]
+      }
+
+  try {
+    const response = await fetch(url, {
+      method: 'POST',
+      headers: {
+        Authorization: `Bearer ${selectedKey.value.key}`,
+        'Content-Type': 'application/json'
+      },
+      body: JSON.stringify(body),
+      signal: abortController.signal
+    })
+    httpStatus.value = response.status
+    latencyMs.value = Math.round(performance.now() - startedAt)
+
+    const responseText = await response.text()
+    let payload: unknown = responseText
+    try {
+      payload = JSON.parse(responseText)
+    } catch {
+      // Keep non-JSON upstream responses visible in the summary.
+    }
+    responseSummary.value = typeof payload === 'string' ? payload : summarizeResponse(payload)
+
+    if (!response.ok) {
+      throw new Error(extractError(payload, `HTTP ${response.status}`))
+    }
+
+    if (isImageMode.value) {
+      generatedImages.value = extractImages(payload)
+      textOutput.value = extractText(payload)
+      if (generatedImages.value.length === 0) {
+        throw new Error(t('admin.accounts.modelTest.noImage'))
+      }
+    } else {
+      textOutput.value = extractText(payload)
+      if (!textOutput.value) {
+        throw new Error(t('admin.accounts.modelTest.noText'))
+      }
+    }
+
+    status.value = 'success'
+  } catch (error) {
+    if (error instanceof DOMException && error.name === 'AbortError') return
+    latencyMs.value = Math.round(performance.now() - startedAt)
+    errorMessage.value = error instanceof Error ? error.message : t('admin.accounts.modelTest.requestFailed')
+    status.value = 'error'
+  } finally {
+    abortController = null
+  }
+}
+
+onMounted(loadKeys)
+onBeforeUnmount(cancelRequest)
+</script>
+
+<style scoped>
+.fade-enter-active,
+.fade-leave-active {
+  transition: opacity 0.2s ease;
+}
+
+.fade-enter-from,
+.fade-leave-to {
+  opacity: 0;
+}
+</style>
