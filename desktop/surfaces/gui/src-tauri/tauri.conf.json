{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BoxAI Desktop",
  "version": "0.1.7",
  "identifier": "com.you-box.boxai.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' http://127.0.0.1:* ws://127.0.0.1:*; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQyOUIwNEZBRTgwOTAwQzUKUldURkFBbm8rZ1NiUWpJaVlEQ2FjTXpmZ0FDTDNZdXpuZ0JFOHR1bFNmdWJvQm9JVnN5RFM0VlUK",
      "endpoints": ["https://dl.you-box.com/desktop/latest.json"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "BoxAI",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "binaries/sidecar": "sidecar"
    },
    "macOS": {
      "entitlements": "entitlements.plist",
      "minimumSystemVersion": "12.0"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
