---
import { langOf, languages, localePath, t } from '../i18n';

const current = langOf(Astro.url.pathname);
const currentLabel = languages.find(({ lang }) => lang === current)!.label;
---

<details class="language-menu" data-language-menu>
	<summary aria-label={t(current).chooseLanguage} aria-controls="language-options">
		{currentLabel}
		<svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="m4 6 4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5"></path></svg>
	</summary>
	<div id="language-options">
		{
			languages.map(({ lang, tag, label }) => (
				<a
					href={localePath(lang, Astro.url.pathname)}
					lang={tag}
					hreflang={tag}
					aria-current={lang === current ? 'true' : undefined}
				>
					{label}
				</a>
			))
		}
	</div>
</details>

<script>
	const menu = document.querySelector<HTMLDetailsElement>('[data-language-menu]');
	if (menu) {
		const summary = menu.querySelector('summary')!;
		const links = menu.querySelectorAll('a');
		const syncHash = () => {
			const hash = /^#[a-zA-Z0-9_][a-zA-Z0-9_./:-]*$/.test(location.hash) ? location.hash : '';
			for (const link of links) link.hash = hash;
		};
		syncHash();
		menu.addEventListener('toggle', syncHash);
		window.addEventListener('hashchange', syncHash);
		for (const link of links) link.addEventListener('click', syncHash);
		menu.addEventListener('keydown', (event) => {
			if (event.key === 'Escape' && menu.open) {
				event.preventDefault();
				menu.open = false;
				summary.focus();
			}
		});
		menu.addEventListener('focusout', (event) => {
			if (!menu.contains(event.relatedTarget as Node | null)) menu.open = false;
		});
		document.addEventListener('click', (event) => {
			if (!menu.contains(event.target as Node)) menu.open = false;
		});
	}
</script>

<style>
	.language-menu {
		position: relative;
	}
	summary {
		display: flex;
		align-items: center;
		gap: 0.375rem;
		padding: 0.5rem;
		border-radius: calc(var(--radius) - 2px);
		color: var(--foreground);
		font-size: 0.875rem;
		white-space: nowrap;
		list-style: none;
		cursor: pointer;
	}
	summary::-webkit-details-marker {
		display: none;
	}
	summary:hover,
	a:hover {
		background: var(--accent);
		color: var(--accent-foreground);
	}
	summary:focus-visible,
	a:focus-visible {
		outline: 2px solid var(--docs-link);
		outline-offset: 2px;
	}
	#language-options {
		position: absolute;
		top: calc(100% + 0.5rem);
		right: 0;
		z-index: 1;
		min-width: 10rem;
		padding: 0.375rem;
		border: 1px solid var(--border);
		border-radius: var(--radius);
		background: var(--background);
		color: var(--foreground);
		box-shadow: 0 8px 24px #0000002e;
	}
	a {
		display: block;
		padding: 0.5rem 0.75rem;
		border-radius: calc(var(--radius) - 2px);
		color: inherit;
		text-decoration: none;
	}
	a[aria-current] {
		color: var(--docs-link);
		font-weight: 600;
	}
</style>
