VITE_API_TARGET=http://localhost:3000
VITE_DEV_PORT=5175
VITE_TRUSTED_EXTERNAL_ORIGINS=
# Console/auth transport: "mock" (default, stateful in-browser demo) or "http"
# (real same-origin backend; admin flags then derive from the server role).
VITE_API_MODE=mock
# Optional public-page override; defaults to VITE_API_MODE.
VITE_PUBLIC_API_MODE=
