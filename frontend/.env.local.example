# API proxy target
# VITE_API_TARGET=http://localhost:3000

# API transports: mock (default) or http. Public pages inherit VITE_API_MODE.
# VITE_API_MODE=mock
# VITE_PUBLIC_API_MODE=

# Dev server port
# VITE_DEV_PORT=5175

# Comma-separated origins allowed for external docs, invoices and images
# VITE_TRUSTED_EXTERNAL_ORIGINS=https://docs.example.com,https://cdn.example.com
