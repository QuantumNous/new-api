{
  "unixNow": 1789000000,
  "cases": [
    {
      "name": "Seedream Responses submit remains deferred",
      "hook": "protocols",
      "path": ["openai_responses", "decodeRequest"],
      "args": [
        {
          "model": "doubao-seedream-5-0-pro-260628",
          "upstreamModel": "doubao-seedream-5-0-pro-260628",
          "stream": false,
          "body": {
            "kind": "json",
            "value": {
              "model": "doubao-seedream-5-0-pro-260628",
              "input": "a red observatory",
              "size": "2048x2048",
              "n": 2
            }
          }
        }
      ],
      "expected": {
        "kind": "submit",
        "model": "doubao-seedream-5-0-pro-260628",
        "action": "text_to_image",
        "execution": "deferred",
        "requestBody": {
          "model": "doubao-seedream-5-0-pro-260628",
          "prompt": "a red observatory",
          "size": "2048x2048",
          "n": 2
        }
      }
    },
    {
      "name": "mapped alias submits the declared upstream model",
      "hook": "buildSubmitRequest",
      "args": [
        {
          "model": "customer-seedream",
          "upstreamModel": "doubao-seedream-5-0-pro-260628",
          "baseUrl": "https://ark.example.test",
          "apiKey": "fixture-key",
          "publicTaskId": "task_fixture",
          "requestBody": {
            "model": "customer-seedream",
            "prompt": "a red observatory",
            "size": "2048x2048",
            "n": 2
          }
        }
      ],
      "expected": {
        "url": "https://ark.example.test/api/v3/images/generations",
        "method": "POST",
        "headers": {
          "Content-Type": "application/json",
          "Accept": "application/json",
          "Authorization": "Bearer fixture-key"
        },
        "body": {
          "model": "doubao-seedream-5-0-pro-260628",
          "prompt": "a red observatory",
          "size": "2048x2048",
          "n": 2
        },
        "action": "text_to_image",
        "rewriteModel": "doubao-seedream-5-0-pro-260628"
      }
    },
    {
      "name": "completed image task exposes host-proxy artifacts",
      "hook": "listArtifacts",
      "args": [
        {
          "status": "SUCCESS",
          "data": {
            "media_type": "image",
            "response": {
              "data": [{ "url": "https://upstream.example.test/one.png" }, { "url": "https://upstream.example.test/two.png" }]
            }
          }
        }
      ],
      "expected": [
        { "key": "image-1", "type": "image" },
        { "key": "image-2", "type": "image" }
      ]
    },
    {
      "name": "image artifact GET content request is credentialless",
      "hook": "buildContentRequest",
      "args": [
        {
          "artifactKey": "image-1",
          "clientRequest": { "method": "GET" },
          "data": {
            "media_type": "image",
            "response": {
              "data": [{ "url": "https://upstream.example.test/one.png" }, { "url": "https://upstream.example.test/two.png" }]
            }
          }
        }
      ],
      "expected": {
        "url": "https://upstream.example.test/one.png",
        "method": "GET",
        "credentialless": true
      }
    },
    {
      "name": "image artifact content request is credentialless",
      "hook": "buildContentRequest",
      "args": [
        {
          "artifactKey": "image-2",
          "clientRequest": { "method": "HEAD" },
          "data": {
            "media_type": "image",
            "response": {
              "data": [{ "url": "https://upstream.example.test/one.png" }, { "url": "https://upstream.example.test/two.png" }]
            }
          }
        }
      ],
      "expected": {
        "url": "https://upstream.example.test/two.png",
        "method": "HEAD",
        "credentialless": true
      }
    },
    {
      "name": "Responses output uses host artifact capabilities",
      "hook": "protocols",
      "path": ["openai_responses", "renderFinal"],
      "args": [
        {
          "artifacts": {
            "image-1": {
              "key": "image-1",
              "type": "image",
              "mimeType": "image/png",
              "url": "https://gateway.example.test/v1/tasks/task_fixture/artifacts/image-1/content?access=capability"
            },
            "image-2": {
              "key": "image-2",
              "type": "image",
              "mimeType": "image/png",
              "url": "https://gateway.example.test/v1/tasks/task_fixture/artifacts/image-2/content?access=capability"
            }
          }
        },
        {
          "task_id": "task_fixture",
          "status": "SUCCESS",
          "action": "text_to_image",
          "data": {
            "media_type": "image",
            "response": {
              "data": [{ "url": "https://upstream.example.test/one.png" }, { "url": "https://upstream.example.test/two.png" }]
            }
          }
        }
      ],
      "expected": {
        "output": [
          {
            "type": "message",
            "status": "completed",
            "role": "assistant",
            "content": [
              {
                "type": "output_text",
                "text": "![Image 1](<https://gateway.example.test/v1/tasks/task_fixture/artifacts/image-1/content?access=capability>)\n\n![Image 2](<https://gateway.example.test/v1/tasks/task_fixture/artifacts/image-2/content?access=capability>)",
                "annotations": [],
                "logprobs": []
              }
            ]
          }
        ],
        "metadata": { "vendor": "doubao" }
      }
    }
  ]
}
