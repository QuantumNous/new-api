# ============================================
# 生产环境环境变量配置
# 使用方法：复制此文件为 .env 并修改配置
#   cp .env.example .env
#   nano .env
# ============================================

# ============================================
# 本地构建推送凭据（不会用于生产容器）
# 用法：复制 production-deploy/.build.env.example 为 production-deploy/.build.env
# ============================================
ACR_USERNAME=beacherlin
ACR_PASSWORD=

# ============================================
# 服务器配置（请修改为你的服务器信息）
# ============================================
SERVER_USER=root
SERVER_HOST=your-server-ip
SERVER_PATH=/opt/production-deploy

# ============================================
# 镜像配置（阿里云 ACR）
# ============================================
NEW_API_IMAGE=crpi-bij57v7e3thiuuod.cn-shenzhen.personal.cr.aliyuncs.com/ccpg_einwin/new-api:1.1.0
CLIPROXY_API_IMAGE=localhost/cliproxyapi:1.0.0

# ============================================
# 时区
# ============================================
TZ=Asia/Shanghai

# ============================================
# New API 配置
# ============================================
NEW_API_PORT=3000
NEW_API_DATA_DIR=./new-api-data
NEW_API_LOGS_DIR=./new-api-logs
NEW_API_CPU_LIMIT=2.0
NEW_API_MEMORY_LIMIT=2G
NEW_API_CPU_RESERVATION=0.5
NEW_API_MEMORY_RESERVATION=512M
SYNC_FREQUENCY=60
RELAY_TIMEOUT=300
STREAMING_TIMEOUT=120
MAX_REQUEST_BODY_MB=32
MAX_FILE_DOWNLOAD_MB=64
STREAM_SCANNER_MAX_BUFFER_MB=128
SQL_MAX_IDLE_CONNS=100
SQL_MAX_OPEN_CONNS=500
SQL_MAX_LIFETIME=300

# ============================================
# CLIProxyAPI 配置
# ============================================
CLIPROXY_API_PORT=8317
CLIPROXY_MGMT_PORT=8085
CLIPROXY_API_CONFIG_DIR=./cliproxy-config
CLIPROXY_API_AUTH_DIR=./cliproxy-auth
CLIPROXY_API_LOGS_DIR=./cliproxy-logs
CLIPROXY_API_CPU_LIMIT=1.0
CLIPROXY_API_MEMORY_LIMIT=1G
CLIPROXY_API_CPU_RESERVATION=0.25
CLIPROXY_API_MEMORY_RESERVATION=256M
DEPLOY=production

# ============================================
# 数据库配置（共享 PostgreSQL）
# ============================================
DB_USER=root
DB_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD
DB_NAME=postgres
PG_DATA_DIR=./pg-data
PG_CPU_LIMIT=1.0
PG_MEMORY_LIMIT=1G
PG_CPU_RESERVATION=0.25
PG_MEMORY_RESERVATION=256M

# ============================================
# Redis 配置（共享）
# ============================================
REDIS_DATA_DIR=./redis-data
REDIS_CPU_LIMIT=0.5
REDIS_MEMORY_LIMIT=512M
REDIS_CPU_RESERVATION=0.1
REDIS_MEMORY_RESERVATION=128M

# ============================================
# CLIProxyAPI 管理密码（请修改为强密码）
# ============================================
MANAGEMENT_PASSWORD=change-me-to-a-strong-password

# ============================================
# 数据库连接字符串（根据上面的配置自动生成）
# ============================================
SQL_DSN=postgresql://root:CHANGE_ME_TO_A_STRONG_PASSWORD@postgres:5432/new-api
REDIS_CONN_STRING=redis://redis:6379/0
PGSTORE_DSN=postgresql://root:CHANGE_ME_TO_A_STRONG_PASSWORD@postgres:5432/cliproxy
PGSTORE_SCHEMA=cliproxy
