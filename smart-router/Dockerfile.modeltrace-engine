# Build context: smart-router. The named dependency context is an audited local
# image, not a registry digest: --build-context modeltrace-dependencies=docker-image://<prepared-tag>.
FROM golang:1.23-bookworm AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w -X main.releasePythonSHA256=3fbc4d6c766a7a5d56c4bcc80d3325181a05f1b64596eb7cf622f0ec056dd546 -X main.releaseRuntimeSHA256=d86ea47a18a9c6088e2dad96c6a7761c3551048b128531a2717d036640dd188b -X main.releaseVendorSHA256=a05e5ab39f1056a0a0234d5e033d1dc3bc1cc259b90c68df460debec38794714" -o /out/modeltraced ./cmd/modeltraced
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w -X main.releasePythonSHA256=3fbc4d6c766a7a5d56c4bcc80d3325181a05f1b64596eb7cf622f0ec056dd546 -X main.releaseRuntimeSHA256=d86ea47a18a9c6088e2dad96c6a7761c3551048b128531a2717d036640dd188b -X main.releaseVendorSHA256=a05e5ab39f1056a0a0234d5e033d1dc3bc1cc259b90c68df460debec38794714" -o /out/modeltrace ./cmd/modeltrace
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/inventory-provisioner ./cmd/inventory-provisioner

FROM python:3.14.7-slim-bookworm@sha256:998acd06f485adfd6890e3e15a4b542543e0cf22ff904310095da328a5e3e561
COPY --from=modeltrace-dependencies /wheels/ /wheels/
COPY modeltrace_runtime/requirements.lock /opt/modeltrace/requirements.lock
RUN printf '%s  %s\n' 6c557de964a32c08ef4b216470f2bb766d3a2f00c63f13f04c775163b771e33a /opt/modeltrace/requirements.lock 3fbc4d6c766a7a5d56c4bcc80d3325181a05f1b64596eb7cf622f0ec056dd546 /usr/local/bin/python3.14 | sha256sum -c - \
    && /usr/local/bin/python3.14 -m pip install --disable-pip-version-check --no-cache-dir --no-index --find-links=/wheels --require-hashes -r /opt/modeltrace/requirements.lock \
    && rm -rf /wheels
WORKDIR /opt/modeltrace
COPY modeltrace_runtime/__init__.py modeltrace_runtime/bank_validation.py modeltrace_runtime/engine.py modeltrace_runtime/worker.py modeltrace_runtime/RUNTIME-MANIFEST.json ./modeltrace_runtime/
COPY third_party/modeltrace/ ./third_party/modeltrace/
COPY --from=build /out/modeltraced /out/modeltrace /out/inventory-provisioner /usr/local/bin/
ENV SMART_ROUTER_MODELTRACE_ENABLED=true \
    SMART_ROUTER_MODELTRACE_LISTEN=0.0.0.0:18086 \
    SMART_ROUTER_MODELTRACE_ALLOW_NON_LOOPBACK=true \
    SMART_ROUTER_MODELTRACE_DATABASE=/data/modeltrace/attribution.db \
    SMART_ROUTER_MODELTRACE_PYTHON=/usr/local/bin/python3.14 \
    SMART_ROUTER_MODELTRACE_WORKER=/opt/modeltrace/modeltrace_runtime/worker.py \
    SMART_ROUTER_MODELTRACE_RUNTIME_MANIFEST=/opt/modeltrace/modeltrace_runtime/RUNTIME-MANIFEST.json \
    SMART_ROUTER_MODELTRACE_VENDOR_MANIFEST=/opt/modeltrace/third_party/modeltrace/PROVENANCE.json
USER 65532:65532
EXPOSE 18086
ENTRYPOINT ["/usr/local/bin/modeltraced"]
