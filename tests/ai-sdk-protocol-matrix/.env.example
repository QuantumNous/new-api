# Never commit a real key. The live runner refuses to start without this value.
NEWAPI_API_KEY=

# Dedicated NewAPI test deployment supplied for this matrix.
NEWAPI_BASE_URL=http://107.175.65.211:3000

# Optional model overrides.
MATRIX_CHAT_MODEL=kimi-k2.7-code
MATRIX_RESPONSES_MODEL=gpt-5.6-terra
MATRIX_CLAUDE_MODEL=minimax-m3
