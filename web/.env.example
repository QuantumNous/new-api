# Portal origins.
#
# Leave both empty when the client and admin portals are served from one
# origin (local development, single-domain deployments). Cross-portal auth
# redirects then stay relative, e.g. `/login` and `/admin/login`.
#
# Set them to absolute origins when the portals are deployed on separate
# subdomains. Redirects between the portals then use these origins:
#
# VITE_CLIENT_BASE_URL=https://app.example.com
# VITE_ADMIN_BASE_URL=https://admin.example.com
VITE_CLIENT_BASE_URL=
VITE_ADMIN_BASE_URL=
